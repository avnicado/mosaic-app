# Server-side only (read by api/*; never shipped to the browser).
GROQ_API_KEY=gsk_...          # https://console.groq.com/keys (free tier)
TAVILY_API_KEY=tvly-...       # https://app.tavily.com/ (free tier ≈ 1000 searches/month)

# Sign-in. Required when deployed (the API refuses everything without it);
# optional locally (unset = no sign-in on localhost).
APP_PASSWORD=choose-a-long-passphrase
# SESSION_SECRET=...          # optional; defaults to APP_PASSWORD

# Where the record lives when deployed: Vercel → Storage → Marketplace →
# Upstash Redis → connect to this project (injects these). Locally without
# them, the record is kept in .data/store.json.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx

# Optional: lets the daily Vercel Cron refresh the Promenade shelf at 06:00 UTC.
# CRON_SECRET=long-random-string

# --- People ------------------------------------------------------------------
# You are the owner: sign in with APP_PASSWORD (name field empty, or OWNER_NAME).
# Invite others from Settings → People; each gets a private record.
# OWNER_NAME=owner
# OPEN_SIGNUP=off             # close open sign-up (invites only)
# MAX_USERS=5                 # optional cap on people besides the owner (open invites count); unset = no limit

# --- Local-only: Claude as the model (via the Claude Code CLI) ----------------
# When Groq is missing, down, or rate-limited, the local server answers with
# `claude -p` (Sonnet) instead. Never used on Vercel.
# LLM_BACKEND=claude          # always use Claude, skip Groq
# LLM_FALLBACK=off            # never fall back to Claude
# CLAUDE_MODEL=sonnet
